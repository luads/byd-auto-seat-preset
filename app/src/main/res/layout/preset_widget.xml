<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seat presets" android:textColor="@color/matte_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:paddingBottom="10dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <LinearLayout android:id="@+id/favourite_one_target" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_button" android:elevation="2dp" android:padding="10dp" android:clickable="true">
      <ImageView android:id="@+id/favourite_one_art" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/seat_matte" android:scaleType="fitCenter" android:padding="8dp" android:importantForAccessibility="no"/>
      <TextView android:id="@+id/favourite_one" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/matte_silver" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/favourite_two_target" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_button" android:elevation="2dp" android:padding="10dp" android:clickable="true">
      <ImageView android:id="@+id/favourite_two_art" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/seat_matte" android:scaleType="fitCenter" android:padding="8dp" android:importantForAccessibility="no"/>
      <TextView android:id="@+id/favourite_two" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/matte_silver" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/widget_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:paddingTop="10dp" android:textColor="@color/matte_muted" android:textSize="12sp"/>
</LinearLayout>